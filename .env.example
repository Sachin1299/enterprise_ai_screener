# ==============================================================================
# Enterprise Candidate Intelligence & Screening Agent - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=Enterprise-Candidate-Intelligence-Screener
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM & Embedding Settings (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Vector DB & Storage
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
UPLOAD_DIRECTORY=./data/uploads

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Agentic Safeguards
MAX_RECURSION_LIMIT=10
DEFAULT_STRICTNESS=balanced
LOG_LEVEL=INFO

